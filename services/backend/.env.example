# Application
APP_NAME=Vibely
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database (local Docker Postgres by default; swap for Supabase etc. in production)
DATABASE_URL=postgresql://vibely:vibely@localhost:5432/vibely?schema=public

# Redis (local Docker Redis by default; swap for Upstash etc. in production)
REDIS_URL=redis://localhost:6379

# Live streaming (self-hosted LiveKit SFU, see infrastructure/docker-compose.yml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret

# JWT - CHANGE THESE IN PRODUCTION
JWT_SECRET=local-dev-jwt-secret-change-in-production-1234567890
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-production-1234567890
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# WebRTC TURN/STUN
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_PASSWORD=your-turn-password

# Storage (S3-compatible)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=vibely-uploads

# Payment Provider (Razorpay)
# Get test-mode keys from https://dashboard.razorpay.com/app/keys (no KYC needed for test mode)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Set from Dashboard > Webhooks after creating a webhook pointed at
# https://your-domain/api/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_SANDBOX=true

# Push Notifications
PUSH_NOTIFICATION_KEY=your-fcm-server-key

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Admin
ADMIN_EMAIL=admin@vibely.app
ADMIN_PASSWORD=change-me-in-production
