# Application
APP_NAME=Vibely
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database (Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxx.supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:YOUR_PASSWORD@us1-xxxxx.upstash.io:6379

# JWT - CHANGE THESE IN PRODUCTION
JWT_SECRET=local-dev-jwt-secret-change-in-production-1234567890
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-production-1234567890
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# WebRTC TURN/STUN
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_PASSWORD=your-turn-password

# Storage (S3-compatible)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=vibely-uploads

# Payment Provider
PAYMENT_PROVIDER=razorpay
PAYMENT_PUBLIC_KEY=your-payment-public-key
PAYMENT_SECRET_KEY=your-payment-secret-key

# Push Notifications
PUSH_NOTIFICATION_KEY=your-fcm-server-key

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Admin
ADMIN_EMAIL=admin@vibely.app
ADMIN_PASSWORD=change-me-in-production
