# Application
APP_NAME=Vibely
NODE_ENV=production
API_PORT=4000
WEB_URL=https://vibely.app
ADMIN_URL=https://admin.vibely.app

# Database
DATABASE_URL=postgresql://vibely:vibely_password@postgres:5432/vibely

# Redis
REDIS_URL=redis://:redis_password@redis:6379

# JWT - CHANGE THESE IN PRODUCTION
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_REFRESH_SECRET=your-secure-refresh-secret-key-here
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# WebRTC TURN/STUN
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_PASSWORD=your-turn-password

# Storage (S3-compatible)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=vibely-uploads

# Payment Provider
PAYMENT_PROVIDER=razorpay
PAYMENT_PUBLIC_KEY=your-payment-public-key
PAYMENT_SECRET_KEY=your-payment-secret-key

# Push Notifications
PUSH_NOTIFICATION_KEY=your-fcm-server-key

# CORS
CORS_ORIGIN=https://vibely.app,https://admin.vibely.app

# Admin
ADMIN_EMAIL=admin@vibely.app
ADMIN_PASSWORD=change-me-in-production
