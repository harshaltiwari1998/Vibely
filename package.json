{
  "name": "vibely",
  "version": "0.1.0",
  "private": true,
  "description": "Vibely - a social live video chat platform (foundation / architecture)",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshaltiwari1998/Vibely.git"
  },
  "workspaces": [
    "apps/web",
    "apps/admin",
    "apps/android",
    "services/backend",
    "packages/config",
    "packages/types",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w services/backend",
    "build:web": "npm run build -w apps/web",
    "build:admin": "npm run build -w apps/admin",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w services/backend",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Vibely",
  "license": "UNLICENSED"
}
