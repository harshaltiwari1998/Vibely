# =====================================================================
# Vibely - Environment configuration (EXAMPLE ONLY)
# Copy this file to `.env` and fill in real values for local dev.
# NEVER commit a real .env file with secrets.
# =====================================================================

# ----- Application -----
# Configurable product name (used for branding across web/admin/android)
APP_NAME=Vibely
APP_TAGLINE=Meet. Chat. Connect.

# ----- Database -----
DATABASE_URL=postgresql://vibely:vibely@localhost:5432/vibely?schema=public

# ----- Cache -----
REDIS_URL=redis://localhost:6379

# ----- Auth -----
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ----- Network -----
API_PORT=4000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ----- WebRTC / TURN -----
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=vibely
TURN_PASSWORD=change-me-turn-secret

# ----- Object storage -----
STORAGE_ENDPOINT=https://storage.example.com
STORAGE_ACCESS_KEY=change-me-access-key
STORAGE_SECRET_KEY=change-me-secret-key
STORAGE_BUCKET=vibely-assets

# ----- Payments -----
PAYMENT_PROVIDER=stripe
PAYMENT_PUBLIC_KEY=pk_test_change_me
PAYMENT_SECRET_KEY=sk_test_change_me

# ----- Push notifications -----
PUSH_NOTIFICATION_KEY=change-me-vapid-key
